data/uploads/*
data/processed/*
data/reports/*
data/.keras/
data/.mplconfig/
data/.tmp/
!data/models/**
!data/confusion_matrix.png
!data/performance_benchmark_results.json
logs/*.log

# Database
*.db
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Agent conversations (privacy — do not share)
.gemini/

# OS files
Thumbs.db
.DS_Store

# Temporary
*.tmp
*.bak
